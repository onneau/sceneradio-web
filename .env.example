# Copy this file to ".env" and change what you want. Everything is optional.

# true when the web app sits behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false

# Maximum number of simultaneous listeners
MAX_LISTENERS=40

# Notice in Settings when a newer version exists
UPDATE_CHECK=true

# Covers and artist photos (the server looks them up at MusicBrainz, the Cover Art Archive and Wikimedia). false = off.
COVERS=true

# Port on the machine where the web app is reachable
WEB_PORT=8080
TZ=Europe/Amsterdam
